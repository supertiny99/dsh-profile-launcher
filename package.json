{
	"name": "@supertiny99/dsh-profile-launcher",
	"version": "0.4.1",
	"description": "DeepSeek Harness (DSH) 多 Profile 桌面版一键启动器：在桌面端内发现全部 profile 环境、识别运行状态与当前实例，并以独立 user-data 目录绕开单实例锁实现不同 profile 桌面版双开并存；新建 profile 可选从既有 profile 继承模型相关配置（settings.yaml / .credentials.yaml / .env）。",
	"type": "module",
	"main": "src/index.js",
	"author": "supertiny99",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/supertiny99/dsh-profile-launcher.git"
	},
	"homepage": "https://github.com/supertiny99/dsh-profile-launcher#readme",
	"bugs": {
		"url": "https://github.com/supertiny99/dsh-profile-launcher/issues"
	},
	"exports": {
		".": "./src/index.js",
		"./client": "./dist/client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation"
			]
		}
	},
	"engines": {
		"node": ">=20",
		"dsh": ">=0.2.1-rc.5 <0.3.0"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"dsh-plugin",
		"profile",
		"launcher",
		"multi-instance",
		"dev-sandbox"
	],
	"scripts": {
		"build": "node scripts/build.mjs && node scripts/selfcheck.mjs",
		"test": "node tests/test-launcher-core.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.25.10"
	},
	"files": [
		"src",
		"dist/client.js",
		"dist/badge",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	]
}
